campaigns/*/qc/*.mp4
campaigns/*/qc/*.wav
*.mp4
*.mov
*.webm
*.wav
*.mp3
*.m4a
*.ogg

# Keep optional reference templates if explicitly tracked via `git add -f`
!brands/*/assets/*.svg
